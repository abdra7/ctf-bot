# Discord bot credentials — NEVER commit the real values
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Postgres connection string, e.g.
# postgresql://ctf_user:ctf_password@localhost:5432/ctf_bot?schema=public
DATABASE_URL=

# Comma-separated list of Discord role IDs that should be treated as admins
# (in addition to members with the Administrator permission)
ADMIN_ROLE_IDS=

# Restrict the bot to a single channel name/id (optional, informational only —
# enforce with Discord channel permissions for real security)
CTF_CHANNEL_NAME=اختيار-التحدي-والمشاركين
